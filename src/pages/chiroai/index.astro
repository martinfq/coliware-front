---
import "../../components/chiroai/chiro.css";
import TopNav from "../../components/chiroai/TopNav.astro";
import HeroSection from "../../components/chiroai/HeroSection.astro";
import ProblemSection from "../../components/chiroai/ProblemSection.astro";
import HowSection from "../../components/chiroai/HowSection.astro";
import DeunaSection from "../../components/chiroai/DeunaSection.astro";
import UseCasesSection from "../../components/chiroai/UseCasesSection.astro";
import CategoriesSection from "../../components/chiroai/CategoriesSection.astro";
import ReportsSection from "../../components/chiroai/ReportsSection.astro";
import ChannelsSection from "../../components/chiroai/ChannelsSection.astro";
import FinalCopySection from "../../components/chiroai/FinalCopySection.astro";
import DownloadSection from "../../components/chiroai/DownloadSection.astro";
import FooterSection from "../../components/chiroai/FooterSection.astro";

---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Controla tus gastos sin registrarlos manualmente. Envía tus comprobantes por WhatsApp o Telegram."
		/>
		<meta property="og:title" content="Chiro AI — Tú gastas. Chiro registra." />
		<meta
			property="og:description"
			content="Controla tus gastos sin registrarlos manualmente. Envía tus comprobantes por WhatsApp o Telegram."
		/>
		<meta property="og:type" content="website" />
        <meta property="og:image" content="https://tudominio.com/og-image.png">
		<meta property="og:url" content="https://coliware.com/chiroai/" />
		<meta property="og:site_name" content="Chiro AI" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Chiro AI — Tú gastas. Chiro registra." />
		<meta
			name="twitter:description"
			content="Controla tus gastos sin registrarlos manualmente. Envía tus comprobantes por WhatsApp o Telegram."
		/>
		<title>Chiro AI — Tú gastas. Chiro registra.</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="chiro-page">
		<TopNav />
		<main>
			<HeroSection />
			<ProblemSection />
			<HowSection />
			<DeunaSection />
			<UseCasesSection />
			<CategoriesSection />
			<ReportsSection />
			<ChannelsSection />
			<FinalCopySection />
			<DownloadSection />
		</main>
		<FooterSection />
	</body>
</html>
