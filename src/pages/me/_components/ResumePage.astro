---
import type { ResumeContent, ResumeLocale } from '../_utils/content';

type Props = {
	locale: ResumeLocale;
	content: ResumeContent;
};

const { locale, content } = Astro.props;
const esHref = '/me/es';
const enHref = '/me/en';
---

<html lang={locale} data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={content.metaDescription} />
		<title>{content.title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			(() => {
				const saved = localStorage.getItem('me-cv-theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const theme = saved === 'light' || saved === 'dark' ? saved : prefersDark ? 'dark' : 'light';
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
	</head>
	<body>
		<div class="ambient" aria-hidden="true"></div>
		<header class="topbar">
			<div class="topbar-inner">
				<p class="brand">{content.brand}</p>
				<div class="controls">
					<nav class="lang-switch" aria-label={content.langAria}>
						<a class={locale === 'es' ? 'active' : undefined} href={esHref}>ES</a>
						<a class={locale === 'en' ? 'active' : undefined} href={enHref}>EN</a>
					</nav>
					<select class="lang-dropdown" data-lang-select aria-label={content.langAria}>
						<option value={esHref} selected={locale === 'es'}>ES</option>
						<option value={enHref} selected={locale === 'en'}>EN</option>
					</select>
					<button
						class="theme-btn"
						type="button"
						data-theme-toggle
						data-light-label={content.lightLabel}
						data-dark-label={content.darkLabel}
						aria-label={content.themeAria}
					>
						{content.themePrefix} <span data-theme-label>{content.darkLabel}</span>
					</button>
				</div>
			</div>
		</header>

		<main class="cv">
			<section class="hero card reveal">
				<p class="eyebrow">{content.eyebrow}</p>
				<h1>Martin Fierro</h1>
				<h2>{content.role}</h2>
				<div class="hero-grid">
					<article>
						<h3>{content.profileTitle}</h3>
						<p>{content.profileText}</p>
					</article>
					<article>
						<h3>{content.contactTitle}</h3>
						<ul>
							{content.contactItems.map((item) => <li>{item}</li>)}
						</ul>
					</article>
				</div>
			</section>

			<section class="skills card reveal">
				<header>
					<p class="section-label">{content.skillsSectionLabel}</p>
					<h3>{content.skillsTitle}</h3>
				</header>
				<div class="skills-grid">
					<article>
						<h4>{content.softSkillsTitle}</h4>
						<ul>
							{content.softSkills.map((item) => <li>{item}</li>)}
						</ul>
					</article>
					<article>
						<h4>{content.hardSkillsTitle}</h4>
						<ul>
							{content.hardSkills.map((item) => <li>{item}</li>)}
						</ul>
					</article>
				</div>
			</section>

			<section class="experience card reveal">
				<header>
					<p class="section-label">{content.experienceSectionLabel}</p>
					<h3>{content.experienceTitle}</h3>
				</header>
				<div class="timeline">
					{content.experienceItems.map((item) => (
						<article>
							<p class="period">{item.period}</p>
							<h4>{item.title}</h4>
							<p>{item.description}</p>
						</article>
					))}
				</div>
			</section>

			<section class="projects card reveal">
				<header>
					<p class="section-label">{content.projectsSectionLabel}</p>
					<h3>{content.projectsTitle}</h3>
				</header>
				<div class="project-list">
					{content.projectItems.map((item) => (
						<article>
							<h4>{item.title}</h4>
							<p>{item.description}</p>
						</article>
					))}
				</div>
			</section>

			<section class="certifications card reveal">
				<header>
					<p class="section-label">{content.certSectionLabel}</p>
					<h3>{content.certTitle}</h3>
				</header>
				<ul class="cert-list">
					{content.certifications.map((item) => <li>{item}</li>)}
				</ul>
			</section>
		</main>

		<script is:inline>
			(() => {
				const key = 'me-cv-theme';
				const root = document.documentElement;
				const button = document.querySelector('[data-theme-toggle]');
				const label = document.querySelector('[data-theme-label]');
				const select = document.querySelector('[data-lang-select]');
				const lightLabel = button?.getAttribute('data-light-label') || 'Light';
				const darkLabel = button?.getAttribute('data-dark-label') || 'Dark';

				const applyTheme = (theme) => {
					root.setAttribute('data-theme', theme);
					localStorage.setItem(key, theme);
					if (label) {
						label.textContent = theme === 'light' ? lightLabel : darkLabel;
					}
				};

				applyTheme(root.getAttribute('data-theme') === 'light' ? 'light' : 'dark');

				if (button) {
					button.addEventListener('click', () => {
						const nextTheme = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
						applyTheme(nextTheme);
					});
				}

				if (select) {
					select.addEventListener('change', (event) => {
						const target = event.target;
						if (!(target instanceof HTMLSelectElement)) {
							return;
						}
						if (target.value) {
							window.location.href = target.value;
						}
					});
				}
			})();
		</script>
	</body>
</html>

<style>
	:root {
		--ink: #ffffff;
		--surface: rgba(9, 9, 12, 0.82);
		--line: #2f2f39;
		--accent: #c9a4ff;
		--accent-soft: #dfceff;
		--bg-a: #20122a;
		--bg-b: #0d0d0f;
		--dot: rgba(201, 164, 255, 0.1);
	}

	html[data-theme='light'] {
		--ink: #111111;
		--surface: rgba(255, 255, 255, 0.9);
		--line: #d3d8c4;
		--accent: #6b7a34;
		--accent-soft: #a3b072;
		--bg-a: #f8faf2;
		--bg-b: #ffffff;
		--dot: rgba(107, 122, 52, 0.12);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		min-height: 100vh;
		font-family: 'Sora', sans-serif;
		background: radial-gradient(circle at 14% 8%, var(--bg-a) 0%, var(--bg-b) 46%),
			radial-gradient(circle at 86% 82%, var(--bg-a) 0%, var(--bg-b) 45%);
		color: var(--ink);
		overflow-x: hidden;
	}

	.ambient {
		position: fixed;
		inset: 0;
		pointer-events: none;
		background-image: linear-gradient(var(--dot) 1px, transparent 1px),
			linear-gradient(90deg, var(--dot) 1px, transparent 1px);
		background-size: 46px 46px;
		mask-image: radial-gradient(circle at center, black 26%, transparent 86%);
	}

	.topbar {
		position: sticky;
		top: 0;
		z-index: 9;
		backdrop-filter: blur(10px);
		background: color-mix(in srgb, var(--bg-b) 82%, transparent);
		border-bottom: 1px solid var(--line);
	}

	.topbar-inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 0.8rem clamp(0.85rem, 2vw, 1.9rem);
	}

	.brand {
		font-family: 'IBM Plex Mono', monospace;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.controls {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.lang-switch {
		display: inline-flex;
		border: 1px solid var(--line);
		border-radius: 999px;
		overflow: hidden;
	}

	.lang-switch a {
		padding: 0.42rem 0.8rem;
		text-decoration: none;
		font-size: 0.78rem;
		font-family: 'IBM Plex Mono', monospace;
		color: var(--ink);
		background: transparent;
	}

	.lang-switch a.active {
		background: var(--accent);
		color: #ffffff;
	}

	.lang-dropdown {
		display: none;
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 0.42rem 0.8rem;
		font-size: 0.78rem;
		font-family: 'IBM Plex Mono', monospace;
		background: transparent;
		color: var(--ink);
	}

	.theme-btn {
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 0.42rem 0.8rem;
		font-family: 'IBM Plex Mono', monospace;
		font-size: 0.78rem;
		background: transparent;
		color: var(--ink);
		cursor: pointer;
	}

	.cv {
		width: 100%;
		display: grid;
		gap: 1rem;
		padding: clamp(0.75rem, 2vw, 2rem);
		position: relative;
		z-index: 1;
	}

	.card {
		border: 1px solid var(--line);
		background: var(--surface);
		backdrop-filter: blur(6px);
		padding: clamp(1rem, 2.5vw, 2rem);
		border-radius: 18px;
	}

	.hero {
		padding: clamp(1.5rem, 4vw, 3rem);
		background: linear-gradient(
				130deg,
				color-mix(in srgb, var(--accent) 18%, transparent),
				color-mix(in srgb, var(--accent-soft) 12%, transparent)
			),
			var(--surface);
	}

	.eyebrow {
		font-family: 'IBM Plex Mono', monospace;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-size: 0.78rem;
		margin-bottom: 0.75rem;
	}

	h1 {
		font-size: clamp(2.6rem, 7vw, 5.4rem);
		line-height: 0.95;
		letter-spacing: -0.04em;
		color: var(--accent-soft);
	}

	h2 {
		font-size: clamp(1.05rem, 2.3vw, 1.8rem);
		font-weight: 500;
		margin-top: 0.85rem;
		color: var(--ink);
	}

	.hero-grid {
		margin-top: 1.6rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	h3 {
		font-size: clamp(1.3rem, 2.4vw, 2rem);
		letter-spacing: -0.02em;
		margin-bottom: 0.8rem;
	}

	h4 {
		font-size: 1.05rem;
		margin-bottom: 0.55rem;
		color: var(--accent);
	}

	p,
	li {
		line-height: 1.65;
		color: color-mix(in srgb, var(--ink) 92%, transparent);
	}

	ul {
		list-style: none;
		display: grid;
		gap: 0.4rem;
	}

	li::before {
		content: '*';
		color: var(--accent);
		display: inline-block;
		width: 1em;
		margin-left: -1em;
	}

	.section-label {
		font-family: 'IBM Plex Mono', monospace;
		font-size: 0.76rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--accent);
		margin-bottom: 0.6rem;
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.skills-grid article,
	.timeline article,
	.project-list article {
		padding: 1rem;
		border: 1px solid color-mix(in srgb, var(--line) 88%, transparent);
		border-radius: 14px;
		background: color-mix(in srgb, var(--surface) 90%, transparent);
	}

	.timeline,
	.project-list {
		display: grid;
		gap: 0.85rem;
	}

	.period {
		font-family: 'IBM Plex Mono', monospace;
		font-size: 0.8rem;
		color: var(--accent);
		margin-bottom: 0.45rem;
	}

	.cert-list {
		display: grid;
		gap: 0.55rem;
	}

	.reveal {
		opacity: 0;
		transform: translateY(14px);
		animation: rise 0.7s ease forwards;
	}

	.hero.reveal {
		animation-delay: 0.05s;
	}

	.skills.reveal {
		animation-delay: 0.15s;
	}

	.experience.reveal {
		animation-delay: 0.25s;
	}

	.projects.reveal {
		animation-delay: 0.35s;
	}

	.certifications.reveal {
		animation-delay: 0.45s;
	}

	@keyframes rise {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 900px) {
		.hero-grid,
		skills-grid {
			grid-template-columns: 1fr;
		}

		.topbar-inner {
			flex-wrap: wrap;
		}

		.lang-switch {
			display: none;
		}

		.lang-dropdown {
			display: inline-block;
		}

		.cv {
			padding: 0.6rem;
			gap: 0.75rem;
		}

		h1 {
			font-size: clamp(2.1rem, 13vw, 3.5rem);
		}

		.card {
			border-radius: 14px;
		}
	}
</style>
